{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/tradplus.json",
  "title": "TradPlus bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the TradPlus adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/fa73b89049767eaab6d9f48dc3b0a275db563233/static/bidder-params/tradplus.json",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string",
      "description": "Account ID",
      "minLength": 1
    },
    "zoneId": {
      "type": "string",
      "description": "Zone ID",
      "pattern": "^[a-zA-Z0-9.-]*$"
    }
  },
  "required": [
    "accountId"
  ]
}
