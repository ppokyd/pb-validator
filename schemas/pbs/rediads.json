{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/rediads.json",
  "title": "RediAds bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the Rediads adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/8cf6dd22cb217f5d7bc52366880c0e7fb254e4db/static/bidder-params/rediads.json",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "slot": {
      "type": "string"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.-]+$"
    }
  },
  "required": [
    "account_id"
  ]
}
