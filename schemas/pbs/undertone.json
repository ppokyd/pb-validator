{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/undertone.json",
  "title": "Undertone bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the Undertone adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/f660bedc03ef1a51f6af8dcd0dd6ab61e1d4c417/static/bidder-params/undertone.json",
  "type": "object",
  "properties": {
    "placementId": {
      "type": "integer",
      "minimum": 1,
      "description": "Undertone unique placement identifier"
    },
    "publisherId": {
      "type": "integer",
      "minimum": 1,
      "description": "Publisher unique identifier"
    }
  },
  "required": [
    "placementId",
    "publisherId"
  ]
}
