{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/bidwave.json",
  "title": "BidWave bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the BidWave adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/0f7916bfd975b82a185e9677d8196d94b2ea4dcc/static/bidder-params/bidwave.json",
  "type": "object",
  "properties": {
    "publisherId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "Publisher ID"
    }
  },
  "required": [
    "publisherId"
  ]
}
