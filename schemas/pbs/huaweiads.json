{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/huaweiads.json",
  "title": "HuaweiAds bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the HuaweiAds adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/4239545b20e9ca4f6e7ff288738b37f7a57a691a/static/bidder-params/huaweiads.json",
  "type": "object",
  "properties": {
    "publisherid": {
      "type": "string",
      "description": "publisher id",
      "minLength": 1
    },
    "signkey": {
      "type": "string",
      "description": "the sign key of publisher",
      "minLength": 1
    },
    "keyid": {
      "type": "string",
      "description": "the key id of publisher",
      "minLength": 1
    },
    "slotid": {
      "type": "string",
      "description": "ad slot id",
      "minLength": 1
    },
    "adtype": {
      "type": "string",
      "description": "ad type",
      "minLength": 1
    }
  },
  "required": [
    "publisherid",
    "signkey",
    "keyid",
    "slotid",
    "adtype"
  ]
}
