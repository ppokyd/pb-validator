{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/superedge.json",
  "title": "SuperEdge bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the SuperEdge adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/361cd6c93d7e1212aa41c9584016659c50f0c13d/static/bidder-params/superedge.json",
  "type": "object",
  "properties": {
    "sk": {
      "type": "string",
      "description": "Publisher token, communicated by SuperEdge.",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "description": "Server region: US for US Region, EU for EU Region, SG for Singapore Region. Default is US.",
      "enum": [
        "US",
        "EU",
        "APAC"
      ]
    }
  },
  "required": [
    "sk"
  ],
  "additionalProperties": false
}
