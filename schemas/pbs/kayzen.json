{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/kayzen.json",
  "title": "Kayzen bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the Kayzen adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/8cf6dd22cb217f5d7bc52366880c0e7fb254e4db/static/bidder-params/kayzen.json",
  "type": "object",
  "properties": {
    "zone": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9.-]+$",
      "description": "Zone ID"
    },
    "exchange": {
      "type": "string",
      "minLength": 1,
      "description": "Exchange/Publisher Name"
    }
  },
  "required": [
    "zone",
    "exchange"
  ]
}
