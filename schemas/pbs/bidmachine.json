{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/bidmachine.json",
  "title": "Bidmachine bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the Kidoz adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/8cf6dd22cb217f5d7bc52366880c0e7fb254e4db/static/bidder-params/bidmachine.json",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1,
      "description": "Host",
      "pattern": "^[a-zA-Z0-9.-]+(:[0-9]+)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "URL path"
    },
    "seller_id": {
      "type": "string",
      "minLength": 1,
      "description": "Seller Identifier"
    }
  },
  "required": [
    "host",
    "path",
    "seller_id"
  ]
}
