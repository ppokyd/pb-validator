{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prebid.org/schemas/pbs/smartyads.json",
  "title": "SmartyAds bidder params (Prebid Server)",
  "description": "A schema which validates params accepted by the SmartyAds adapter",
  "x-source-url": "https://github.com/prebid/prebid-server/blob/8cf6dd22cb217f5d7bc52366880c0e7fb254e4db/static/bidder-params/smartyads.json",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "description": "Network host to send request",
      "pattern": "^[a-zA-Z0-9.-]+(:[0-9]+)?$"
    },
    "sourceid": {
      "type": "string",
      "description": "Partner id"
    },
    "accountid": {
      "type": "string",
      "description": "Account id"
    }
  },
  "required": [
    "host",
    "sourceid",
    "accountid"
  ]
}
